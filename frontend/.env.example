# Local development defaults. You can omit this file when every service runs locally.
VITE_API_URL=http://localhost:3001/api
VITE_API_ORIGIN=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Bundled PeerJS signaling server
VITE_PEER_HOST=127.0.0.1
VITE_PEER_PORT=9000
VITE_PEER_PATH=/peerjs
VITE_PEER_SECURE=false

# GIF araması backend üzerinden GIPHY ile yapılır; anahtar backend/.env içinde tutulur.
