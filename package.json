{
  "name": "discord-clone",
  "version": "1.0.0",
  "description": "Discord-like chat application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "electron-builder",
    "build": "npm run build:frontend && npm run build:electron",
    "postinstall": "cd backend && npm install && cd ../frontend && npm install"
  },
  "build": {
    "appId": "com.chatapp.discord-clone",
    "productName": "Discord Clone",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data.json",
          "!data.sqlite",
          "!data.sqlite-*",
          "!datayedek.json",
          "!datayedek2.json",
          "!datayedek*.json",
          "!.env*",
          "!uploads/**/*",
          "!node_modules/.bin/**/*",
          "!node_modules/nodemon/**/*",
          "!node_modules/@types/**/*",
          "!**/*.md",
          "!**/*.map"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!nodemon/**/*",
          "!@types/**/*",
          "!**/*.md",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "LSMultipleInstancesProhibited": true,
        "NSMicrophoneUsageDescription": "Discord Clone sesli sohbet için mikrofonunu kullanır.",
        "NSCameraUsageDescription": "Discord Clone görüntülü sohbet için kameranı kullanır.",
        "NSAudioCaptureUsageDescription": "Discord Clone ekran yayını sırasında sistem sesini paylaşmak için ses yakalama izni kullanır."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "concurrently": "^10.0.4",
    "wait-on": "^9.1.0",
    "cross-env": "^10.1.0"
  }
}
