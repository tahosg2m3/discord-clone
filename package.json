{
  "name": "tahosapp",
  "version": "1.1.0",
  "description": "Tahosapp desktop communication application",
  "author": "tahosg2m3",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "electron-builder",
    "build": "npm run build:frontend && npm run build:electron",
    "postinstall": "cd backend && npm install && cd ../frontend && npm install"
  },
  "build": {
    "appId": "com.chatapp.discord-clone",
    "productName": "tahosapp",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data.json",
          "!data.json.*.tmp",
          "!data.sqlite",
          "!data.sqlite-*",
          "!data.sqlite*.tmp",
          "!discord-clone.sqlite",
          "!discord-clone.sqlite-*",
          "!discord-clone.sqlite*.tmp",
          "!data.sqlite-key",
          "!data.sqlite-key.*.tmp",
          "!data-encryption.key",
          "!data-encryption.key.*.tmp",
          "!data-encryption-migration.json",
          "!data-encryption-migration.json.*.tmp",
          "!data-encryption-key.safe",
          "!data-encryption-key.safe.*.tmp",
          "!datayedek.json",
          "!datayedek2.json",
          "!datayedek*.json",
          "!.env*",
          "!uploads/**/*",
          "!node_modules/.bin/**/*",
          "!node_modules/nodemon/**/*",
          "!node_modules/@types/**/*",
          "!**/*.md",
          "!**/*.map"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!nodemon/**/*",
          "!@types/**/*",
          "!**/*.md",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "installer/tahosapp.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "tahosapp",
      "runAfterFinish": true,
      "installerLanguages": ["tr_TR", "en_US"],
      "license": "installer/license_tr.txt",
      "include": "installer/installer.nsh",
      "installerIcon": "installer/tahosapp.ico",
      "uninstallerIcon": "installer/tahosapp.ico",
      "artifactName": "tahosapp-Setup-${version}.${ext}",
      "uninstallDisplayName": "tahosapp ${version}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "LSMultipleInstancesProhibited": true,
        "NSMicrophoneUsageDescription": "tahosapp sesli sohbet için mikrofonunu kullanır.",
        "NSCameraUsageDescription": "tahosapp görüntülü sohbet için kameranı kullanır.",
        "NSAudioCaptureUsageDescription": "tahosapp ekran yayını sırasında sistem sesini paylaşmak için ses yakalama izni kullanır."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "concurrently": "^10.0.4",
    "wait-on": "^9.1.0",
    "cross-env": "^10.1.0"
  }
}
